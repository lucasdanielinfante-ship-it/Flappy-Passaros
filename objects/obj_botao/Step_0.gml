//usando lerp para criar a animação do botão horzintalmente
image_xscale = lerp(image_xscale, escalax, 0.1)
//usando lerp para criar a animação do botao verticalmente
image_yscale = lerp(image_yscale, escalay, 0.1)
//usando lerp para o texto acompanhar a animação do botão horizontalmente
escala_texto_x = lerp(escala_texto_x, 1, 0.1)
//usando lerp para o texto acompanhar a animação do botão verticalmente
escala_texto_y = lerp(escala_texto_y, 1, 0.1)